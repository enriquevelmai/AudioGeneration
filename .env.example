# Claves de API de los motores en la nube de podcast_tts (opcionales).
#
# Copia este fichero a .env (que git ignora) y rellena solo los proveedores que uses,
# o guárdalas con:  python -m podcast_tts config set OPENAI_API_KEY
# (o desde la pestaña "Ajustes" de la UI). Las variables de entorno tienen prioridad
# sobre este fichero. NUNCA subas .env a git ni compartas tus claves.
#
# Los motores locales (f5, xtts) no necesitan claves, pero sus pesos son de uso
# NO comercial. Ver docs/COMMERCIAL_USE.md.

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Azure AI Speech: clave y región del recurso "Speech" en el portal de Azure
# (p.ej. westeurope, eastus). No es Edge-TTS.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
