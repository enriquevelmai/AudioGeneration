# API keys for the podcast_tts cloud engines (optional).
#
# Copy this file to .env (ignored by git) and fill in only the providers you use,
# or save them with:  python -m podcast_tts config set OPENAI_API_KEY
# (or from the "Settings" tab of the UI). Environment variables take precedence
# over this file. NEVER commit .env to git or share your keys.
#
# The local engines (f5, xtts) need no keys, but their weights are for
# NON-commercial use only. See docs/COMMERCIAL_USE.md.

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Azure AI Speech: key and region of the "Speech" resource in the Azure portal
# (e.g. westeurope, eastus). This is not Edge-TTS.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
